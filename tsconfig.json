// Editor-only project for the tooling config files no workspace tsconfig
// covers (lint-staged, eslint). Without it the editor puts them in an
// "inferred project" with its own defaults — including the node10 module
// resolution TypeScript 6 reports as deprecated. Not built or typechecked by
// any script; each app and package has its own tsconfig for real code.
{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "allowJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    // The root has no node_modules/@types; borrow the api's Node types so
    // config files using import.meta.dirname or process type-check.
    "typeRoots": ["./apps/api/node_modules/@types"],
    "types": ["node"]
  },
  "include": ["*.js", "apps/*/*.js", "apps/*/*.mjs"]
}
