# Copy to .env.local (Next.js loads it automatically and gitignores it).
# Vars exposed to the browser MUST be prefixed with NEXT_PUBLIC_.

# Where the browser sends API calls. /api (the default) goes through this app,
# which forwards it to API_ORIGIN, so the auth cookie stays first-party.
NEXT_PUBLIC_API_URL="/api"

# The API's own address, where /api/* is forwarded (next.config.ts). Server-
# only — never sent to the browser — and read at build time.
API_ORIGIN="http://localhost:3001"
