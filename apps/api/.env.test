# Environment for the e2e suite (pnpm --filter api test:e2e).
#
# Committed on purpose: nothing here is secret, and a fresh clone should be able
# to run the tests after creating the database once:
#
#   docker exec vinyl-postgres createdb -U vinyl vinyl_test
#
# ConfigModule reads .env.${NODE_ENV} before .env, so these win over your dev
# .env while NODE_ENV=test. test/global-setup.ts reads this file too, and
# refuses to run unless the database name ends in _test.
NODE_ENV=test

# A SEPARATE database in the same docker-compose Postgres. The e2e suite resets
# it on every run, so it must never point at the dev database (vinyl).
DATABASE_URL="postgresql://vinyl:vinyl@localhost:5432/vinyl_test?schema=public"

# Tests sign their own tokens with this; it is not a secret and is never used
# outside the test database.
JWT_SECRET="test-secret-not-used-anywhere-else"
JWT_EXPIRES_IN="1d"

# Required by env.validation.ts or the app will not boot. Tests never call
# Discogs.
DISCOGS_TOKEN="test-token"
