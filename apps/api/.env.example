# Copy to .env and fill in. .env is gitignored.

# Postgres connection (local dev runs in the docker-compose container)
DATABASE_URL="postgresql://vinyl:vinyl@localhost:5432/vinyl?schema=public"

# Auth
# Generate a secret with: openssl rand -hex 32
JWT_SECRET="change-me"
# Token lifetime — accepts ms-style strings ("15m", "1d") or seconds as a number
JWT_EXPIRES_IN="1d"

# CORS browser allowlist — origins allowed to call the API from a browser.
# Comma-separated for multiple, e.g. "http://localhost:3000,https://yourstore.com"
WEB_ORIGIN="http://localhost:3000"
