# Copy to .env and fill in. .env is gitignored.

# Postgres connection (local dev runs in the docker-compose container)
DATABASE_URL="postgresql://vinyl:vinyl@localhost:5432/vinyl?schema=public"

# Auth
# Generate a secret with: openssl rand -hex 32
JWT_SECRET="change-me"
# Token lifetime — accepts ms-style strings ("15m", "1d") or seconds as a number
JWT_EXPIRES_IN="1d"

# CORS browser allowlist — origins allowed to call the API from a browser.
# Comma-separated for multiple, e.g. "http://localhost:3000,https://yourstore.com"
WEB_ORIGIN="http://localhost:3000"

# Discogs catalog API — create a personal access token at
# https://www.discogs.com/settings/developers (server-side secret, never exposed)
DISCOGS_TOKEN="change-me"
# Descriptive User-Agent (required by Discogs, else 403). Defaults if unset.
DISCOGS_USER_AGENT="VinylOrder/0.1"

# Image storage. local = save to UPLOAD_DIR and serve at /uploads (dev);
# gcs = Google Cloud Storage (production, added later).
STORAGE_DRIVER="local"
UPLOAD_DIR="./uploads"
# Base URL used to build public image URLs (and where /uploads is served).
PUBLIC_API_URL="http://localhost:3001"
