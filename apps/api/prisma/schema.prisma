// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  customer
  admin
}

/// Where an order is in its life. Checkout only ever creates `pending`; the
/// rest exist so payment, shipping and cancellation don't each need a
/// migration just to add a value.
enum OrderStatus {
  pending
  paid
  shipped
  cancelled
}

/// Why an order left `pending` without being paid.
enum CancelReason {
  customer
  expired
}

/// Where one payment attempt stands. Only the provider's webhook moves it off
/// `pending`; the customer returning from the payment page proves nothing.
enum PaymentStatus {
  pending
  succeeded
  failed
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         Role     @default(customer)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  cart   Cart?
  orders Order[]
}

/// A customer's shopping cart. One per user, created lazily on first add.
///
/// Holds no prices. A cart shows what the shop charges *now*, so it stores
/// only what was chosen; the amount actually paid is snapshotted onto the
/// order at checkout. Keeping a price here would either go stale or duplicate
/// the snapshot that belongs to the order.
model Cart {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  items CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// One line in a cart: a product and how many copies.
model CartItem {
  id     String @id @default(uuid())
  cartId String
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// The shop's offer this line buys. Null until checkout moves onto offers
  /// (tracker.md step 5), which drops productId and makes this required.
  /// Cascade: a line for an offer that's gone can't be bought.
  offerId String?
  offer   Offer?  @relation(fields: [offerId], references: [id], onDelete: Cascade)

  quantity Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Adding a record already in the cart must bump its quantity rather than
  /// create a second line, so the pair is unique.
  @@unique([cartId, productId])
  @@index([cartId])
  /// Postgres doesn't index foreign keys itself; deleting an offer looks up
  /// its cart lines by this.
  @@index([offerId])
}

/// A placed order: a record of what was bought, never recalculated.
///
/// Unlike the cart, every amount here is stored rather than derived. An order
/// is a financial record, so it must read the same later even if the products
/// it came from are repriced or deleted.
///
/// It holds no products directly — only lines. "This order contains that
/// record" means nothing without how many and at what price, and those facts
/// belong to the pairing, so the join table is a model of its own.
model Order {
  id     String @id @default(uuid())
  /// Restrict: a financial record must not vanish because a user row did.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  status        OrderStatus @default(pending)
  /// Sum of the lines at purchase.
  subtotalCents Int
  currency      String

  items OrderItem[]

  /// The client's id for one checkout attempt, so a retry lands on the order
  /// the first request created instead of making a second one. Null for
  /// checkouts that sent no key — Postgres treats nulls as distinct, so any
  /// number of them coexist.
  idempotencyKey String?

  /// Deadline to pay, fixed at checkout (createdAt + 15 min) so changing the
  /// window later does not move it for orders already placed.
  expiresAt    DateTime
  /// Set together with cancelReason, exactly when status is `cancelled`. A
  /// CHECK constraint in the add_order_lifecycle migration enforces this;
  /// Prisma's schema cannot express one.
  cancelledAt  DateTime?
  cancelReason CancelReason?
  /// Set exactly when status is `paid` or `shipped`, and shippedAt exactly
  /// when it is `shipped` — CHECK constraints in the add_payments migration.
  paidAt       DateTime?
  shippedAt    DateTime?

  /// Every attempt to pay this order: a declined card and a retry are two.
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Scoped to the user: keys come from clients, so one customer's key must
  /// never collide with — or reveal — another's. Also the shape of the lookup
  /// that answers a retry.
  @@unique([userId, idempotencyKey])
  /// "My orders, newest first", which is also the pagination order.
  @@index([userId, createdAt(sort: Desc)])
  /// The expiry sweeper: pending orders past their deadline.
  @@index([status, expiresAt])
}

/// One line of an order, with the product copied in as it was at purchase.
///
/// No unique (orderId, productId) as CartItem has: lines are written once at
/// checkout and never merged.
model OrderItem {
  id      String @id @default(uuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// A link back to the product while it exists. SetNull on delete: the copy
  /// below is what the order renders from, so the line outlives the product.
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  /// The offer bought, while it exists — SetNull for the same reason as
  /// productId. `supplier` is copied, so a past order still says which shop
  /// it was "bought" from after the offer is gone. Both null on orders placed
  /// before checkout moved onto offers (tracker.md step 5).
  offerId  String?
  offer    Offer?    @relation(fields: [offerId], references: [id], onDelete: SetNull)
  supplier Supplier?

  quantity       Int
  /// Copied from Product at checkout and never read from it again.
  unitPriceCents Int
  title          String
  artist         String
  imageUrl       String?

  @@index([orderId])
}

/// One attempt to pay an order through the payment provider.
///
/// An attempt, not the order's payment: each needs its own provider id, so a
/// late webhook for a declined first attempt is never read as the result of
/// the second.
model Payment {
  id      String @id @default(uuid())
  /// Restrict: a record of money asked for must not vanish with its order.
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  /// The provider's id for this attempt — what its webhooks name, since the
  /// provider never learns ours. Unique: one row per provider session.
  providerSessionId String        @unique
  status            PaymentStatus @default(pending)
  /// What the provider was asked to collect. A webhook reporting any other
  /// amount or currency is not accepted as payment for the order.
  amountCents       Int
  currency          String
  /// The provider's payment page, so asking to pay again while this attempt
  /// is still open returns the same page instead of starting another.
  redirectUrl       String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Postgres does not index foreign keys itself; "this order's attempts" is
  /// the lookup starting a payment makes.
  ///
  /// At most one `pending` attempt per order, so two Pay presses at once can't
  /// open two payment pages for one order. Failed and succeeded attempts don't
  /// count, so a declined card can still be retried. A partial unique index in
  /// the one_pending_payment_per_order migration enforces this; Prisma's
  /// schema cannot express one.
  @@index([orderId])
}

/// Every webhook we have acted on, by the provider's event id.
///
/// The primary key is what makes a redelivery a no-op: providers deliver at
/// least once, so the same event can arrive twice, and the second insert fails
/// on this key before anything else changes — the same device as the
/// idempotency key on checkout.
///
/// Not related to Payment: an event naming a session we don't know is
/// recorded too, so it is not reprocessed either.
model PaymentEvent {
  /// The provider's event id, not ours: it is what a redelivery repeats.
  id         String   @id
  /// e.g. "payment.succeeded" — the provider's name, kept for tracing what we
  /// acted on, so a string rather than an enum.
  type       String
  receivedAt DateTime @default(now())
}

/// A vinyl product the store sells. Money is stored as integer cents to avoid
/// floating-point rounding.
model Product {
  id         String   @id @default(uuid())
  title      String
  artist     String
  year       Int?
  format     String[]
  imageUrl   String?
  priceCents Int
  currency   String   @default("TWD")
  stock      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  /// Who made the record, under all their names. Null until products are
  /// created from a shop's catalog (tracker.md step 8), which also drops the
  /// `artist` string. Restrict: an artist with records can't vanish.
  artistId    String?
  artistRef   Artist?   @relation(fields: [artistId], references: [id], onDelete: Restrict)
  /// Often unknown: shops give a date for pre-orders and rarely otherwise.
  /// Replaces `year` in step 8.
  releaseDate DateTime? @db.Date
  /// What tells pressings of one album apart, e.g. "日版", "限量彩膠".
  edition     String?

  /// Storefront navigation tabs this record appears under, chosen by the
  /// store rather than read off the record.
  categories Category[]

  cartItems  CartItem[]
  /// Lines of past orders. Deleting a product nulls their link, not the line.
  orderItems OrderItem[]

  /// Each shop's listing of this record.
  offers Offer[]
}

/// A storefront navigation tab.
///
/// Curated rather than derived. Deriving tabs from a string on each record
/// would mean the tab bar changes shape whenever records change, has no order,
/// and no stable identity — renaming the string would silently unassign every
/// record and break any shared link. A row gives each tab a slug that outlives
/// its label.
model Category {
  id        String @id @default(uuid())
  /// URL identity, e.g. "mandarin". Stable across renames of `name`.
  slug      String @unique
  /// Display label, e.g. "華語".
  name      String
  /// Ascending order in the tab bar.
  sortOrder Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@index([sortOrder])
}

// ---- Supplier tracker (docs/design/tracker.md §5) ----

/// A shop the tracker reads. A fifth is a new value and an adapter, not a
/// schema change.
enum Supplier {
  candlelight
  tht
  cosmic
  rotten_blues
}

/// Whether a shop will sell a record now, later, or not at all.
enum Availability {
  in_stock
  pre_order
  sold_out
}

/// Where an order I placed at a shop stands (tracker.md §9.1). Moved by hand
/// for now; any forward move is allowed.
enum SupplierOrderStatus {
  ordered
  preparing
  shipped
  delivered
  cancelled
}

/// One artist or band, under whatever names the shops write it as.
///
/// A list of aliases rather than a column per language: 坂本龍一 has a Chinese
/// and an English name, JENNIE has four, Radiohead has one (tracker.md §5.7).
model Artist {
  id   String @id @default(uuid())
  /// The name the site shows, e.g. "坂本龍一". Also one of the aliases.
  name String

  aliases  ArtistAlias[]
  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// One way an artist's name is written, e.g. "Ryuichi Sakamoto".
model ArtistAlias {
  id       String @id @default(uuid())
  artistId String
  artist   Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  /// As a shop wrote it.
  name       String
  /// Search form of `name`: NFKC, lower case, no punctuation or spaces. What
  /// lookups compare, so "Ryuichi Sakamoto" and "RYUICHI　SAKAMOTO" are one.
  normalized String

  createdAt DateTime @default(now())

  /// Unique per artist, not globally: two different artists can share a name,
  /// and that is shown to me rather than merged.
  @@unique([artistId, normalized])
  /// Trigram index for fuzzy lookups ("sakamoto ryuichi" finding
  /// "ryuichisakamoto"). Needs the pg_trgm extension, which the migration
  /// that adds it creates first.
  @@index([normalized(ops: raw("gin_trgm_ops"))], type: Gin)
}

/// One shop's listing of a record: everything that differs between shops.
///
/// The same columns for every supplier; what a shop doesn't publish is null,
/// never a guess (tracker.md §5.2). Comparing offers happens when read, so
/// nothing about "the cheapest" is stored.
model Offer {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  supplier    Supplier
  /// The shop's own id for the listing.
  externalId  String
  url         String
  /// The shop's own name for the record, to check a match against and to
  /// match the next shop's title with.
  sourceTitle String

  priceCents   Int
  currency     String       @default("TWD")
  availability Availability
  /// The supplier's count; only a refresh writes it. Null: the shop doesn't
  /// say. CHECK (>= 0) in the migration SQL.
  stockQty     Int?
  /// The demo checkout's holds, kept apart from stockQty so a refresh can't
  /// overwrite them (tracker.md §8). CHECK (>= 0) in the migration SQL.
  reservedQty  Int          @default(0)
  /// Expected release or shipping date, when the shop gives one.
  expectedAt   DateTime?    @db.Date

  /// When the values above were last read successfully.
  lastCheckedAt DateTime
  /// The last refresh that failed. The values above are kept from the last
  /// good read, so the page can say how stale they are.
  lastErrorAt   DateTime?
  lastError     String?

  snapshots          OfferSnapshot[]
  cartItems          CartItem[]
  orderItems         OrderItem[]
  supplierOrderItems SupplierOrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// A shop's listing is tracked once, under one record.
  @@unique([supplier, externalId])
  @@index([productId])
}

/// An offer's values at a refresh that changed one of them.
///
/// Written only on change, so each row is an event — "dropped to 1300",
/// "back in stock" — and the table stays small.
model OfferSnapshot {
  id      String @id @default(uuid())
  offerId String
  offer   Offer  @relation(fields: [offerId], references: [id], onDelete: Cascade)

  priceCents   Int
  availability Availability
  stockQty     Int?
  expectedAt   DateTime?    @db.Date

  takenAt DateTime @default(now())

  /// "This offer's history, newest first", and the latest change.
  @@index([offerId, takenAt(sort: Desc)])
}

/// An order I placed at one of the shops: a note of something bought
/// elsewhere, with no payment lifecycle. Kept apart from Order, which is the
/// demo store's own (tracker.md §5.5).
model SupplierOrder {
  id          String              @id @default(uuid())
  supplier    Supplier
  /// The shop's order number.
  orderNumber String
  orderedAt   DateTime            @db.Date
  status      SupplierOrderStatus @default(ordered)

  /// What the shop charged, shipping included. Null until I enter it.
  totalCents     Int?
  currency       String  @default("TWD")
  trackingNumber String?
  note           String?

  items SupplierOrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The same order entered twice is a mistake, not a second order.
  @@unique([supplier, orderNumber])
  /// The page groups by status.
  @@index([status])
}

/// One record in a supplier order.
///
/// The offer link is optional from the start, not only after a delete: a line
/// can be typed for a record I don't track, and linked later (tracker.md
/// §9.2). So the line carries its own title, as OrderItem does.
model SupplierOrderItem {
  id              String        @id @default(uuid())
  supplierOrderId String
  supplierOrder   SupplierOrder @relation(fields: [supplierOrderId], references: [id], onDelete: Cascade)

  offerId String?
  offer   Offer?  @relation(fields: [offerId], references: [id], onDelete: SetNull)

  title          String
  quantity       Int       @default(1)
  unitPriceCents Int
  /// Copied from the offer when added, then editable.
  expectedAt     DateTime? @db.Date

  @@index([supplierOrderId])
  @@index([offerId])
}
