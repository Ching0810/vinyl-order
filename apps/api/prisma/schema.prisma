// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  customer
  admin
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         Role     @default(customer)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// A vinyl product the store sells. Metadata is usually imported from Discogs
/// (discogsReleaseId), but price/stock/image are owned by us. Money is stored as
/// integer cents to avoid floating-point rounding.
model Product {
  id               String   @id @default(uuid())
  discogsReleaseId Int?     @unique
  title            String
  artist           String
  year             Int?
  genres           String[]
  format           String[]
  imageUrl         String?
  priceCents       Int
  currency         String   @default("TWD")
  stock            Int      @default(0)
  /// Featured on the storefront "hot" section.
  isHot            Boolean  @default(false)
  /// Position in the storefront hero carousel, ascending. Null means the
  /// record is not in the carousel at all — membership and position are the
  /// same fact, so one nullable column carries both and the two can never
  /// disagree. Ties fall back to createdAt.
  slideOrder       Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  /// Covers the carousel read: non-null positions, in order.
  @@index([slideOrder])
}