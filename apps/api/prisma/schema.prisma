// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  customer
  admin
}

/// Where an order is in its life. Checkout only ever creates `pending`; the
/// rest exist so payment, shipping and cancellation don't each need a
/// migration just to add a value.
enum OrderStatus {
  pending
  paid
  shipped
  cancelled
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         Role     @default(customer)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  cart   Cart?
  orders Order[]
}

/// A customer's shopping cart. One per user, created lazily on first add.
///
/// Holds no prices. A cart shows what the shop charges *now*, so it stores
/// only what was chosen; the amount actually paid is snapshotted onto the
/// order at checkout. Keeping a price here would either go stale or duplicate
/// the snapshot that belongs to the order.
model Cart {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  items CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// One line in a cart: a product and how many copies.
model CartItem {
  id     String @id @default(uuid())
  cartId String
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  quantity Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Adding a record already in the cart must bump its quantity rather than
  /// create a second line, so the pair is unique.
  @@unique([cartId, productId])
  @@index([cartId])
}

/// A placed order: a record of what was bought, never recalculated.
///
/// Unlike the cart, every amount here is stored rather than derived. An order
/// is a financial record, so it must read the same later even if the products
/// it came from are repriced or deleted.
///
/// It holds no products directly — only lines. "This order contains that
/// record" means nothing without how many and at what price, and those facts
/// belong to the pairing, so the join table is a model of its own.
model Order {
  id     String @id @default(uuid())
  /// Restrict: a financial record must not vanish because a user row did.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  status        OrderStatus @default(pending)
  /// Sum of the lines at purchase.
  subtotalCents Int
  currency      String

  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// "My orders, newest first", which is also the pagination order.
  @@index([userId, createdAt(sort: Desc)])
}

/// One line of an order, with the product copied in as it was at purchase.
///
/// No unique (orderId, productId) as CartItem has: lines are written once at
/// checkout and never merged.
model OrderItem {
  id      String @id @default(uuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// A link back to the product while it exists. SetNull on delete: the copy
  /// below is what the order renders from, so the line outlives the product.
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  quantity       Int
  /// Copied from Product at checkout and never read from it again.
  unitPriceCents Int
  title          String
  artist         String
  imageUrl       String?

  @@index([orderId])
}

/// A vinyl product the store sells. Metadata is usually imported from Discogs
/// (discogsReleaseId), but price/stock/image are owned by us. Money is stored as
/// integer cents to avoid floating-point rounding.
model Product {
  id               String   @id @default(uuid())
  discogsReleaseId Int?     @unique
  title            String
  artist           String
  year             Int?
  genres           String[]
  format           String[]
  imageUrl         String?
  priceCents       Int
  currency         String   @default("TWD")
  stock            Int      @default(0)
  /// Featured on the storefront "hot" section.
  isHot            Boolean  @default(false)
  /// Position in the storefront hero carousel, ascending. Null means the
  /// record is not in the carousel at all — membership and position are the
  /// same fact, so one nullable column carries both and the two can never
  /// disagree. Ties fall back to createdAt.
  slideOrder       Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  /// Storefront navigation tabs this record appears under. Separate from
  /// `genres`, which is descriptive metadata imported from Discogs: a Mandarin
  /// pop record is "Pop" to Discogs with nothing marking it 華語.
  categories Category[]

  cartItems  CartItem[]
  /// Lines of past orders. Deleting a product nulls their link, not the line.
  orderItems OrderItem[]

  /// Covers the carousel read: non-null positions, in order.
  @@index([slideOrder])
}

/// A storefront navigation tab.
///
/// Curated rather than derived. Deriving tabs from `Product.genres` would mean
/// the tab bar changes shape on every import, has no order, and no stable
/// identity — renaming a genre string would silently unassign every record and
/// break any shared link. A row gives each tab a slug that outlives its label.
model Category {
  id   String @id @default(uuid())
  /// URL identity, e.g. "mandarin". Stable across renames of `name`.
  slug String @unique
  /// Display label, e.g. "華語".
  name String
  /// Ascending order in the tab bar.
  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@index([sortOrder])
}