# MockPay's database for the e2e suite (pnpm --filter api test:e2e).
#
# Committed on purpose, like apps/api/.env.test: nothing here is secret, and a
# fresh clone should be able to run the tests after creating the database once:
#
#   docker exec vinyl-postgres createdb -U vinyl mockpay_test
#
# The API's test/global-setup.ts reads this file and resets the database on
# every run, so it refuses to run unless the database name ends in _test. It
# must never point at the dev database (mockpay).
MOCKPAY_DATABASE_URL="postgresql://vinyl:vinyl@localhost:5432/mockpay_test?schema=public"
