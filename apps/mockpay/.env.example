# Copy to .env and fill in. .env is gitignored.
#
# Read by MockPay's own Prisma CLI (migrate, studio), run from apps/mockpay.

# MockPay's own database, in the same docker-compose Postgres as the API's but
# a separate database: MockPay stands in for a third party, so it never shares
# our tables (docs/design/deploy.md §6.5). Create it once with:
#
#   docker exec vinyl-postgres createdb -U vinyl mockpay
MOCKPAY_DATABASE_URL="postgresql://vinyl:vinyl@localhost:5432/mockpay?schema=public"
