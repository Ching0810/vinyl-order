{
  // The API's compiler options, so MockPay's sources typecheck the same way
  // when the API reads them (its "types" entry points at src/).
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    // Nest's dependency injection reads constructor parameter types from the
    // metadata these emit.
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "skipLibCheck": true,
    "types": ["node"],
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false
  },
  // prisma.config.ts is typechecked and linted with the rest, but not built:
  // the Prisma CLI loads it directly (tsconfig.build.json).
  "include": ["src", "prisma.config.ts"]
}
