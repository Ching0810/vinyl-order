# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage

# next.js
.next/
out/

# build output
build
dist/

# generated code (Prisma client, etc. — regenerated from schema)
generated/

# misc
.DS_Store
*.pem

# locally-uploaded images (dev StorageService) — keep the dir, ignore contents
apps/api/uploads/*
!apps/api/uploads/.gitkeep

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — secrets stay local; commit only the *.example templates
.env
.env.*
!.env.example
!.env.*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
